# Copia este archivo a .env.local y completa los valores del proyecto Supabase.
# Solo valores públicos: la URL del proyecto y la anon key. Nunca la
# service_role_key ni contraseñas: todo NEXT_PUBLIC_ termina en el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO DESARROLLO: cuentas de prueba para la barra de cambio de cuenta
# (components/layout/SelectorRolDemo.tsx). Sin NEXT_PUBLIC_: nunca llegan al
# navegador, y en la compilación de producción el código que las lee no existe.
# Las de counter y supervisor las crea el administrador del backend.
DEV_CUENTA_PASAJERO_CORREO=
DEV_CUENTA_PASAJERO_CLAVE=
DEV_CUENTA_COUNTER_CORREO=
DEV_CUENTA_COUNTER_CLAVE=
DEV_CUENTA_SUPERVISOR_CORREO=
DEV_CUENTA_SUPERVISOR_CLAVE=
